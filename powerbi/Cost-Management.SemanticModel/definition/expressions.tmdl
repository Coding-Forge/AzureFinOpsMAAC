/// Loads a generated CSV file from the configured storage location. If the file is not present yet, returns a column-count-shaped empty CSV.
expression CsvFromSelectedStorage = (fileName as text, columnCount as number) as table => let SelectedRoot = if StorageLocation = "Local" then LocalDataRoot else if StorageLocation = "AzureBlob" then BlobDataRoot else if StorageLocation = "ADLSGen2" then AdlsDataRoot else if StorageLocation = "SharePoint" then SharePointDataRoot else error "Unsupported StorageLocation. Use Local, AzureBlob, ADLSGen2, or SharePoint.", TrimmedRoot = Text.Trim(SelectedRoot), RootWithSeparator = if StorageLocation = "Local" then if Text.EndsWith(TrimmedRoot, "\") or Text.EndsWith(TrimmedRoot, "/") then TrimmedRoot else TrimmedRoot & "\" else if Text.EndsWith(TrimmedRoot, "/") then TrimmedRoot else TrimmedRoot & "/", SafeColumnCount = if columnCount < 1 then 1 else columnCount, EmptyCsvBinary = Text.ToBinary(Text.Combine(List.Transform({1..SafeColumnCount}, each "Column" & Text.From(_)), ",")), LoadedCsv = try (if StorageLocation = "Local" then File.Contents(RootWithSeparator & fileName) else Web.Contents(RootWithSeparator & fileName)), CsvBinary = if LoadedCsv[HasError] then EmptyCsvBinary else LoadedCsv[Value], Source = if LoadedCsv[HasError] then Csv.Document(CsvBinary, [Delimiter = ",", Columns = SafeColumnCount, Encoding = 65001, QuoteStyle = QuoteStyle.None]) else Csv.Document(CsvBinary, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.None]) in Source
	lineageTag: e193190f-bf4f-4a9a-bda8-435f2cf7f289

