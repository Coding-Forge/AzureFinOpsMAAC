/// Loads optional billing audit CSV files. Missing billing-contact-audit files return an empty column-count-shaped CSV so older export runs still refresh.
expression OptionalBillingAuditCsvFromSelectedStorage = (fileName as text, columnCount as number) as table => let SelectedRoot = if StorageLocation = "Local" then LocalDataRoot else if StorageLocation = "AzureBlob" then BlobDataRoot else if StorageLocation = "ADLSGen2" then AdlsDataRoot else if StorageLocation = "SharePoint" then SharePointDataRoot else error "Unsupported StorageLocation. Use Local, AzureBlob, ADLSGen2, or SharePoint.", TrimmedRoot = Text.Trim(SelectedRoot), RootWithSeparator = if StorageLocation = "Local" then if Text.EndsWith(TrimmedRoot, "\") or Text.EndsWith(TrimmedRoot, "/") then TrimmedRoot else TrimmedRoot & "\" else if Text.EndsWith(TrimmedRoot, "/") then TrimmedRoot else TrimmedRoot & "/", SafeColumnCount = if columnCount < 1 then 1 else columnCount, EmptyCsvBinary = Text.ToBinary(Text.Combine(List.Transform({1..SafeColumnCount}, each "Column" & Text.From(_)), ",")), CsvBinary = if StorageLocation = "Local" then let NormalizedFileName = Text.Replace(fileName, "/", "\"), RelativeParts = Text.Split(NormalizedFileName, "\"), TargetName = List.Last(RelativeParts), TargetFolderSuffix = if List.Count(RelativeParts) > 1 then Text.Combine(List.RemoveLastN(RelativeParts, 1), "\") & "\" else "", FolderRows = try Folder.Files(RootWithSeparator) otherwise #table({}, {}), MatchingRows = if Table.HasColumns(FolderRows, {"Folder Path", "Name", "Content"}) then Table.SelectRows(FolderRows, each [Name] = TargetName and Text.EndsWith([Folder Path], TargetFolderSuffix)) else #table({}, {}), Content = if Table.RowCount(MatchingRows) > 0 then MatchingRows{0}[Content] else EmptyCsvBinary in Content else let LoadedCsv = try Web.Contents(RootWithSeparator & fileName) in if LoadedCsv[HasError] then EmptyCsvBinary else LoadedCsv[Value], Source = Csv.Document(CsvBinary, [Delimiter = ",", Columns = SafeColumnCount, Encoding = 65001, QuoteStyle = QuoteStyle.None]) in Source
