	partition datedim = m
		mode: import
		source =
				let
				    // Parameters
				    // Replace these defaults with Power Query parameters if desired:
				    // StartDate as Date
				    // EndDate as Date
				    // FiscalYearStartMonth as Number, 1-12
				    StartDate = #date(2020, 1, 1),
				    EndDate = #date(2030, 12, 31),
				    FiscalYearStartMonth = 7,
				
				    // Validation
				    ValidFiscalMonth =
				        if FiscalYearStartMonth >= 1 and FiscalYearStartMonth <= 12
				        then FiscalYearStartMonth
				        else error "FiscalYearStartMonth must be a number between 1 and 12.",
				
				    ValidDateRange =
				        if StartDate <= EndDate
				        then true
				        else error "StartDate must be less than or equal to EndDate.",
				
				    // Generate date list
				    DayCount = Duration.Days(EndDate - StartDate) + 1,
				    DateList = List.Dates(StartDate, DayCount, #duration(1, 0, 0, 0)),
				    DateTable = Table.FromList(DateList, Splitter.SplitByNothing(), {"Date"}),
				
				    // Core date columns
				    ChangedType = Table.TransformColumnTypes(DateTable, {{"Date", type date}}),
				
				    AddedDateKey = Table.AddColumn(
				        ChangedType,
				        "DateKey",
				        each Date.Year([Date]) * 10000 + Date.Month([Date]) * 100 + Date.Day([Date]),
				        Int64.Type
				    ),
				
				    AddedYear = Table.AddColumn(
				        AddedDateKey,
				        "Year",
				        each Date.Year([Date]),
				        Int64.Type
				    ),
				
				    AddedMonth = Table.AddColumn(
				        AddedYear,
				        "Month",
				        each Date.Month([Date]),
				        Int64.Type
				    ),
				
				    AddedDay = Table.AddColumn(
				        AddedMonth,
				        "Day",
				        each Date.Day([Date]),
				        Int64.Type
				    ),
				
				    AddedMonthName = Table.AddColumn(
				        AddedDay,
				        "Month Name",
				        each Date.MonthName([Date]),
				        type text
				    ),
				
				    AddedYearMonth = Table.AddColumn(
				        AddedMonthName,
				        "Year-Month",
				        each Text.From(Date.Year([Date])) & "-" & Text.PadStart(Text.From(Date.Month([Date])), 2, "0"),
				        type text
				    ),
				
				    AddedYearMonthKey = Table.AddColumn(
				        AddedYearMonth,
				        "YearMonthKey",
				        each Date.Year([Date]) * 100 + Date.Month([Date]),
				        Int64.Type
				    ),
				
				    // Fiscal columns
				    AddedFiscalYear = Table.AddColumn(
				        AddedYearMonthKey,
				        "Fiscal Year",
				        each
				            if Date.Month([Date]) >= ValidFiscalMonth
				            then Date.Year([Date]) + 1
				            else Date.Year([Date]),
				        Int64.Type
				    ),
				
				    AddedFiscalYearLabel = Table.AddColumn(
				        AddedFiscalYear,
				        "Fiscal Year Label",
				        each "FY" & Text.From([Fiscal Year]),
				        type text
				    ),
				
				    AddedFiscalMonth = Table.AddColumn(
				        AddedFiscalYearLabel,
				        "Fiscal Month",
				        each
				            Number.Mod(Date.Month([Date]) - ValidFiscalMonth, 12) + 1,
				        Int64.Type
				    ),
				
				    AddedFiscalQuarter = Table.AddColumn(
				        AddedFiscalMonth,
				        "Fiscal Quarter",
				        each "FQ" & Text.From(Number.RoundUp([Fiscal Month] / 3)),
				        type text
				    ),
				
				    ReorderedColumns = Table.ReorderColumns(
				        AddedFiscalQuarter,
				        {
				            "Date",
				            "DateKey",
				            "Year",
				            "Month",
				            "Day",
				            "Month Name",
				            "Year-Month",
				            "YearMonthKey",
				            "Fiscal Year",
				            "Fiscal Year Label",
				            "Fiscal Month",
				            "Fiscal Quarter"
				        }
				    )
				in
				    ReorderedColumns

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

