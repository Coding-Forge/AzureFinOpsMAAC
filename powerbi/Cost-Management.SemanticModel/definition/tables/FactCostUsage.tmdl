	partition FactCostUsage = m
		mode: import
		source =
				let
				    Source = CsvFromSelectedStorage("fact-cost-usage.csv", 15),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Period", type text}, {"SubscriptionId", type text}, {"SubscriptionName", type text}, {"UsageDate", Int64.Type}, {"ServiceName", type text}, {"ResourceLocation", type text}, {"ArmRegionName", type text}, {"MeterKey", type text}, {"Meter", type text}, {"Product", type text}, {"PartNumber", type text}, {"UnitOfMeasure", type text}, {"Currency", type text}, {"UsageQuantity", type number}, {"Cost", type number}}, [MissingField = MissingField.UseNull]),
				    AddUsageDateAsDate = Table.AddColumn(Typed, "UsageDateAsDate", each let d = Number.From([UsageDate]), y = Number.IntegerDivide(d, 10000), m = Number.IntegerDivide(Number.Mod(d, 10000), 100), day = Number.Mod(d, 100) in #date(y, m, day), type date)
				in
				    AddUsageDateAsDate

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

