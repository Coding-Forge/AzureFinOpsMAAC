/// Loads a generated CSV file from the configured storage location.
expression CsvFromSelectedStorage = (fileName as text, columnCount as number) as table => let SelectedRoot = if StorageLocation = "Local" then LocalDataRoot else if StorageLocation = "AzureBlob" then BlobDataRoot else if StorageLocation = "ADLSGen2" then AdlsDataRoot else if StorageLocation = "SharePoint" then SharePointDataRoot else error "Unsupported StorageLocation. Use Local, AzureBlob, ADLSGen2, or SharePoint.", TrimmedRoot = Text.Trim(SelectedRoot), RootWithSeparator = if StorageLocation = "Local" then if Text.EndsWith(TrimmedRoot, "\") or Text.EndsWith(TrimmedRoot, "/") then TrimmedRoot else TrimmedRoot & "\" else if Text.EndsWith(TrimmedRoot, "/") then TrimmedRoot else TrimmedRoot & "/", CsvBinary = if StorageLocation = "Local" then File.Contents(RootWithSeparator & fileName) else Web.Contents(RootWithSeparator & fileName), Source = Csv.Document(CsvBinary, [Delimiter = ",", QuoteStyle = QuoteStyle.None]) in Source
	lineageTag: e193190f-bf4f-4a9a-bda8-435f2cf7f289

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

