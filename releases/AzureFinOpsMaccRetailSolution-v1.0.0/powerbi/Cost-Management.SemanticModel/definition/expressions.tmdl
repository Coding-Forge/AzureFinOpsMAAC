	annotation PBI_ResultType = Text

/// Selects the report load pattern. Current reads MTD and last-month files; History reads cost-retail-history.csv.
expression AnalysisMode = "History" meta [IsParameterQuery=true, List={"Current", "History"}, DefaultValue="Current", Type="Text", IsParameterQueryRequired=true]
	lineageTag: b282eff2-c91c-40e7-96fc-b786c87e07ba

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

