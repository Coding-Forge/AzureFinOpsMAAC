/// Selects where generated CSV files are loaded from. Supported values: Local, AzureBlob, ADLSGen2, SharePoint.
expression StorageLocation = "Local" meta [IsParameterQuery=true, List={"Local", "AzureBlob", "ADLSGen2", "SharePoint"}, DefaultValue="Local", Type="Text", IsParameterQueryRequired=true]
