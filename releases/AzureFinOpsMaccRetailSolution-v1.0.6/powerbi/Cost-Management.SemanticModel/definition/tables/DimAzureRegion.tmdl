	partition DimAzureRegion = m
		mode: import
		source =
				let
				  Source = CsvFromSelectedStorage("dim-region.csv", 5),
				  Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  Typed = Table.TransformColumnTypes(Promoted, {{"Display Name", type text}, {"Azure Region", type text}, {"Azure Cloud", type text}, {"ArmRegionName", type text}, {"ResourceLocation", type text}}, [MissingField = MissingField.UseNull]),
				  NonBlank = Table.SelectRows(Typed, each [ArmRegionName] <> null and Text.Trim(Text.From([ArmRegionName])) <> ""),
				  AddRegionKey = Table.AddColumn(NonBlank, "AzureRegionKey", each Text.Trim(Text.From([#"Azure Cloud"])) & "|" & Text.Trim(Text.From([ArmRegionName])), type text),
				  SortedRows = Table.Sort(AddRegionKey, {{"Azure Cloud", Order.Ascending}, {"Azure Region", Order.Ascending}})
				in
				  SortedRows

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

