	column 'Fiscal Year'
		dataType: int64
		formatString: 0
		lineageTag: 82841b75-b7cd-418a-8d97-7cda864d3b6f
		summarizeBy: sum
		sourceColumn: Fiscal Year

		annotation SummarizationSetBy = Automatic

	partition DimAgreementAsOfDate = m
		mode: import
		source =
				let
				    StartDate = #date(2020, 1, 1),
				    EndDate = #date(2030, 12, 31),
				    FiscalYearStartMonth = 7,
				    ValidFiscalMonth = if FiscalYearStartMonth >= 1 and FiscalYearStartMonth <= 12 then FiscalYearStartMonth else error "FiscalYearStartMonth must be a number between 1 and 12.",
				    DayCount = Duration.Days(EndDate - StartDate) + 1,
				    DateList = List.Dates(StartDate, DayCount, #duration(1, 0, 0, 0)),
				    DateTable = Table.FromList(DateList, Splitter.SplitByNothing(), {"Date"}),
				    ChangedType = Table.TransformColumnTypes(DateTable, {{"Date", type date}}),
				    AddedDateKey = Table.AddColumn(ChangedType, "DateKey", each Date.Year([Date]) * 10000 + Date.Month([Date]) * 100 + Date.Day([Date]), Int64.Type),
				    AddedYear = Table.AddColumn(AddedDateKey, "Year", each Date.Year([Date]), Int64.Type),
				    AddedMonth = Table.AddColumn(AddedYear, "Month", each Date.Month([Date]), Int64.Type),
				    AddedDay = Table.AddColumn(AddedMonth, "Day", each Date.Day([Date]), Int64.Type),
				    AddedMonthName = Table.AddColumn(AddedDay, "Month Name", each Date.MonthName([Date]), type text),
				    AddedYearMonth = Table.AddColumn(AddedMonthName, "Year-Month", each Text.From(Date.Year([Date])) & "-" & Text.PadStart(Text.From(Date.Month([Date])), 2, "0"), type text),
				    AddedYearMonthKey = Table.AddColumn(AddedYearMonth, "YearMonthKey", each Date.Year([Date]) * 100 + Date.Month([Date]), Int64.Type),
				    AddedFiscalYear = Table.AddColumn(AddedYearMonthKey, "Fiscal Year", each if Date.Month([Date]) >= ValidFiscalMonth then Date.Year([Date]) + 1 else Date.Year([Date]), Int64.Type),
				    AddedFiscalYearLabel = Table.AddColumn(AddedFiscalYear, "Fiscal Year Label", each "FY" & Text.From([Fiscal Year]), type text),
				    AddedFiscalMonth = Table.AddColumn(AddedFiscalYearLabel, "Fiscal Month", each Number.Mod(Date.Month([Date]) - ValidFiscalMonth, 12) + 1, Int64.Type),
				    Source = Table.AddColumn(AddedFiscalMonth, "Fiscal Quarter", each "FQ" & Text.From(Number.RoundUp([Fiscal Month] / 3)), type text)
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

